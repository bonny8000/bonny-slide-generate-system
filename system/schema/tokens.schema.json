{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokens.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "description", "foundations", "themes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "foundations": { "$ref": "#/$defs/tokenMap" },
    "themes": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "$ref": "#/$defs/tokenMap" }
    }
  },
  "$defs": {
    "tokenMap": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": { "$ref": "#/$defs/token" }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["color", "dimension", "fontFamily", "fontWeight", "letterSpacing", "lineHeight", "shadow"] },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
